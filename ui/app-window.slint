import {
    Button,
    VerticalBox,
    HorizontalBox,
    Switch,
    TextEdit,
    LineEdit,
    ProgressIndicator,
} from "std-widgets.slint";
import { HeadersSettingDialog } from "headers-setting-dialog.slint";
import { ResultDialog } from "result-dialog.slint";
import { RequestData } from "request-datas.slint";

export { HeadersSettingDialog, ResultDialog, RequestData }
export component AppWindow inherits Window {
    title: "Mini API Controller";
    preferred-width: 550px;
    preferred-height: 250px;
    callback request-clicked(bool);
    callback headers-setting-clicked();
    property <string> edit-font-family: "Consolas";
    property <bool> is_post: false;

    in-out property <bool> loading: false;

    VerticalLayout {
        HorizontalBox {
            Switch {
                text: is_post ? "POST" : "GET  ";
                checked <=> is_post;
            }

            LineEdit {
                placeholder-text: "https://www.example.com/api";
                text <=> RequestData.request-url;
                font-size: 16px;
                font-family: edit-font-family;
                vertical-stretch: 0;
            }

            Button {
                text: "HTTP Headers Setting";
                clicked => {
                    root.headers-setting-clicked();
                }
            }
        }

        VerticalBox {
            TextEdit {
                text <=> RequestData.request-content;
                font-family: edit-font-family;
            }

            ProgressIndicator {
                visible: loading;
                indeterminate: true;
            }

            Button {
                text: is_post ? "POST" : "GET";
                clicked => {
                    root.request-clicked(is_post);
                };
            }
        }
    }
}
