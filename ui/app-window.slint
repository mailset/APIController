import { Button, VerticalBox, HorizontalBox, Switch, TextEdit, LineEdit, ProgressIndicator } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Mini API Controller";
    preferred-width: 550px;
    preferred-height: 250px;
    callback request-clicked(bool);
    callback headers-setting-clicked();
    property <string> edit-font-family: "Consolas";
    property <bool> is_post: false;
    in-out property <string> request-url;
    in-out property <string> request-type: "application/json";
    in-out property <string> request-content: "{\"Content\":\"Hello\"}";
    in-out property <bool> loading: false;
    
    VerticalLayout {
        HorizontalBox {
            Switch {
                text: is_post ? "POST" : "GET  ";
                checked <=> is_post;
            }
            LineEdit {
                placeholder-text: "https://www.example.com/api";
                text <=> request-url;
                font-size: 16px;
                font-family: edit-font-family;
                vertical-stretch: 0;
            }
            Button {
                text: "HTTP Headers Setting";
                clicked => {
                    root.headers-setting-clicked();
                }
            }
        }
        VerticalBox {
            TextEdit {
                text <=> request-content;
                font-family: edit-font-family;
            }
            ProgressIndicator { 
                visible: loading;
                indeterminate: true;
            }
            Button {
                text: is_post ? "POST" : "GET";
                clicked => {
                    root.request-clicked(is_post);
                };
            }
        }
    }
}
