import {
    VerticalBox,
    TextEdit,
    HorizontalBox,
    Button,
    StandardButton,
} from "std-widgets.slint";

import { ControlsBinding } from "../bindings/controls-binding.slint";

export component ResultDialog inherits Dialog {
    title: "Response";
    preferred-height: 450px;
    preferred-width: 600px;
    min-height: 200px;
    min-width: 350px;
    callback copy-body-clicked();
    in-out property <string> request-result-status;
    in-out property <string> request-result-body;
    in-out property <string> request-result-head;
    property <string> edit-font-family: "Consolas";
    VerticalBox {
        Text {
            text: request-result-status;
        }

        HorizontalLayout {
            spacing: 5px;
            TextEdit {
                horizontal-stretch: 2;
                text <=> request-result-head;
                read-only: true;
                font-family: edit-font-family;
            }

            TextEdit {
                horizontal-stretch: 3;
                text <=> request-result-body;
                read-only: true;
                font-family: edit-font-family;
            }
        }

        HorizontalLayout {
            spacing: 5px;
            Button {
                text: "Copy Body";
                clicked => {
                    root.copy-body-clicked();
                };
            }

            StandardButton {
                kind: ok;
                clicked => {
                    root.close();
                }
            }
        }
    }
}
